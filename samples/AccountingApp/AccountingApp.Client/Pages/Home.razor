@page "/"
@inject LedgerCommandDispatcher Dispatcher

<main style="max-width: 820px; margin: 2rem auto; font-family: system-ui, sans-serif;">
    <h1>Verifiable Double-Entry Ledger</h1>
    <p>
        Status: <strong>@_state.StatusText</strong> |
        Total Debits: <strong>@_state.State.TotalDebits.ToString("N2")</strong> |
        Total Credits: <strong>@_state.State.TotalCredits.ToString("N2")</strong>
    </p>

    @if (!string.IsNullOrEmpty(_state.LastError))
    {
        <p style="color: #b91c1c;">@_state.LastError</p>
    }

    <section style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #e5e7eb;">
        <h2>Open Account</h2>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <input type="number" @bind="_newAccId" placeholder="ID" style="width: 70px;" />
            <input @bind="_newAccName" placeholder="Account Name" />
            <select @bind="_newAccType">
                @foreach (var t in Enum.GetValues<AccountType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
            <input @bind="_newAccCurrency" placeholder="USD" style="width: 60px;" />
            <label><input type="checkbox" @bind="_allowOverdraft" /> Overdraft</label>
            <button @onclick="HandleOpenAccountAsync" disabled="@_state.IsSyncing">Open</button>
        </div>
    </section>

    <section style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #e5e7eb;">
        <h2>Post Transfer</h2>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <input type="number" @bind="_fromId" placeholder="From ID" style="width: 80px;" />
            <input type="number" @bind="_toId" placeholder="To ID" style="width: 80px;" />
            <input type="number" step="0.01" @bind="_transferAmount" placeholder="Amount" style="width: 110px;" />
            <input @bind="_memo" placeholder="Memo" />
            <button @onclick="HandleTransferAsync" disabled="@_state.IsSyncing">Post Transfer</button>
        </div>
    </section>

    <h2>Accounts</h2>
    <ul>
        @foreach (var acc in _state.State.Accounts.Values.OrderBy(a => a.Id))
        {
            <li>#@acc.Id @acc.Name (@acc.Kind, @acc.Currency): @acc.Balance.ToString("N2")</li>
        }
    </ul>

    <h2>Append-Only Journal</h2>
    <ul>
        @foreach (var entry in _state.State.Journal)
        {
            <li>
                Entry #@entry.Id — @entry.Memo (Debits: @entry.EntryDebitTotal.ToString("N2"), Credits: @entry.EntryCreditTotal.ToString("N2"))
                @if (entry.IsReversed)
                {
                    <span> [REVERSED]</span>
                }
                else
                {
                    <button @onclick="() => HandleReverseAsync(entry.Id)" disabled="@_state.IsSyncing">Reverse</button>
                }
            </li>
        }
    </ul>
</main>

@code {
    private LedgerUiState _state = LedgerUiState.Initial();
    private int _newAccId = 1;
    private string _newAccName = "Cash";
    private AccountType _newAccType = AccountType.Asset;
    private string _newAccCurrency = "USD";
    private bool _allowOverdraft;

    private int _fromId = 1;
    private int _toId = 2;
    private decimal _transferAmount = 100m;
    private string _memo = "Transfer";

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Dispatcher.LoadLedgerAsync();
        if (loaded.IsSuccess)
        {
            _state = _state with { State = loaded.Value, StatusText = "Loaded" };
        }
    }

    private async Task HandleOpenAccountAsync()
    {
        var cmdId = CommandId.From(Guid.NewGuid());
        var ts = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var req = new OpenAccountHttpRequest(cmdId.Value, _newAccId, _newAccName, _newAccType, _newAccCurrency, _allowOverdraft, ts);
        var (next, cmd) = LedgerUiEngine.OnSubmitOpenAccount(_state, req, cmdId);
        _state = next;
        await DispatchAndApplyAsync(cmd);
    }

    private async Task HandleTransferAsync()
    {
        var cmdId = CommandId.From(Guid.NewGuid());
        var ts = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var req = new PostTransferHttpRequest(cmdId.Value, _fromId, _toId, _transferAmount, _memo, ts);
        var (next, cmd) = LedgerUiEngine.OnSubmitTransfer(_state, req, cmdId);
        _state = next;
        await DispatchAndApplyAsync(cmd);
    }

    private async Task HandleReverseAsync(JournalEntryId entryId)
    {
        var cmdId = CommandId.From(Guid.NewGuid());
        var ts = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var req = new ReverseEntryHttpRequest(cmdId.Value, entryId.Value, ts);
        var (next, cmd) = LedgerUiEngine.OnSubmitReverse(_state, req, cmdId);
        _state = next;
        await DispatchAndApplyAsync(cmd);
    }

    private async Task DispatchAndApplyAsync(UnsentLedgerCommand cmd)
    {
        var res = await Dispatcher.DispatchAsync(cmd);
        _state = res.IsSuccess && _state.IsSyncing && _state.PendingCommandId == res.Value.CommandId
            ? LedgerUiEngine.OnCommitConfirmed(_state, res.Value)
            : LedgerUiEngine.OnCommitFailed(_state, res.IsSuccess ? "Mismatched receipt CommandId." : res.Error);
    }
}
