<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\GalaxyCheck\src\GalaxyCheck\GalaxyCheck.csproj" />
    <ProjectReference Include="..\..\external\GalaxyCheck\src\GalaxyCheck.Xunit\GalaxyCheck.Xunit.csproj" />
    <ProjectReference Include="..\..\src\Verifiable.Contracts\Verifiable.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Verifiable.Generators\Verifiable.Generators.csproj" />
    <ProjectReference Include="..\..\src\Verifiable.Analyzers\Verifiable.Analyzers.csproj" />
    <!-- The stage-0 analyzer that proves src/Verifiable.Core. It defines the same type names as
         Verifiable.Analyzers, so it is not referenced: BootstrapKernelTests loads it from bootstrap/. -->
    <ProjectReference Include="..\..\src\Verifiable.Analyzers.Bootstrap\Verifiable.Analyzers.Bootstrap.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="BootstrapAnalyzer"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <!-- The break-it corpus is input data for SoundnessCorpusTests, not part of this assembly. -->
  <ItemGroup>
    <Compile Remove="Soundness/Corpus/**" />
    <None Remove="Soundness/Corpus/**" />
    <None Include="Soundness/Corpus/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyBootstrapAnalyzer" AfterTargets="Build">
    <Copy SourceFiles="@(BootstrapAnalyzer)" DestinationFolder="$(OutputPath)bootstrap" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRegexGenerator" AfterTargets="Build">
    <ItemGroup>
      <_SdkRegexGenerator Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'System.Text.RegularExpressions.Generator'" />
    </ItemGroup>
    <Copy SourceFiles="@(_SdkRegexGenerator)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_SdkRegexGenerator)' != ''" />
  </Target>

</Project>
