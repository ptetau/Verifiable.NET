{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ptetau/Verifiable.NET/docs/schemas/pack.v1.schema.json",
  "title": "verifiable-query pack result: context packs for agents",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "status",
    "exitCode",
    "maxTokens",
    "packs",
    "page"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proved",
        "refuted",
        "undecided",
        "input_error",
        "tool_missing"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "maxTokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "signature",
          "hole",
          "file",
          "line",
          "contracts",
          "clauses",
          "types",
          "helpers",
          "callers",
          "omitted"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "hole": {
            "type": "boolean"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "types": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "depth",
                "file",
                "line",
                "source",
                "rules"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "class",
                    "struct",
                    "record",
                    "record struct",
                    "enum",
                    "interface"
                  ]
                },
                "depth": {
                  "type": "integer",
                  "description": "0: in the signature, contracts or containing type; each data-member hop adds one; 2: from a helper's signature. Deeper is trimmed first."
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "source": {
                  "type": "string",
                  "description": "The declaration with data members and rules only."
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "member",
                      "reason",
                      "clause"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "member": {
                        "type": "string"
                      },
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "clause": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "helpers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "signature",
                "rank",
                "file",
                "line",
                "contracts"
              ],
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3,
                  "description": "0 named in the contracts, 1 same type, 2 a pack type's method, 3 other contracted method."
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "contracts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "callers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "callSite",
                "file",
                "line",
                "contracts"
              ],
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "callSite": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "contracts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "omitted": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "section",
                "name"
              ],
              "properties": {
                "section": {
                  "enum": [
                    "types",
                    "helpers",
                    "callers"
                  ]
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "limit",
        "returned",
        "total",
        "nextCursor"
      ],
      "properties": {
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pass to --cursor for the next page; null on the last page."
        }
      }
    }
  }
}
