{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ptetau/Verifiable.NET/docs/schemas/lock.v1.schema.json",
  "title": "verifiable-query lock result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "status",
    "exitCode",
    "file",
    "locks"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proved",
        "refuted",
        "undecided",
        "input_error",
        "tool_missing"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "file": {
      "type": [
        "string",
        "null"
      ],
      "description": "The lock file written with --out, or null."
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "hash",
          "clauses"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Type.Member(param types)"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
