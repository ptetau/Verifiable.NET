<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Verifiable.Analyzers</PackageId>
    <Description>Roslyn compile-time Gatekeeper (VER001-VER006), Linear Obligation checker (VER007), and Z3 SMT prover (VER101-VER105) for Verifiable.NET.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Verifiable.Analyzers.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Verifiable.Query</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Verifiable.Query.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The trusted kernel (src/Verifiable.Core) is compiled into this DLL from the same source files that
    Verifiable.Core proves with Z3, so what ships is exactly what was proved. Proof-only lemmas and the
    assembly-level [Verifiable] marker stay in Verifiable.Core. The kernel's Spec.* calls bind to
    KernelShim and are stripped from IL, as they are in user code.
    Verifiable.Analyzers.Bootstrap builds these analyzer sources with a frozen copy of the kernel, and that
    is what proves Verifiable.Core. Keep its package references and Using items in step with this file.
  -->
  <ItemGroup>
    <Compile Include="..\Verifiable.Core\**\*.cs"
             Exclude="..\Verifiable.Core\AssemblyInfo.cs;..\Verifiable.Core\Proofs\**;..\Verifiable.Core\obj\**;..\Verifiable.Core\bin\**"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Using Include="Verifiable.Analyzers.KernelShim.Spec" Alias="Spec" />
    <Using Include="Verifiable.Analyzers.KernelShim.VerifiableAttribute" Alias="VerifiableAttribute" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Verifiable.NET\build\Verifiable.NET.props" Pack="true" PackagePath="build\Verifiable.Analyzers.props;buildTransitive\Verifiable.Analyzers.props" Visible="false" />
    <None Include="..\..\llms.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
