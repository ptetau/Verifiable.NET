<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0'))">$(TargetFrameworks);net9.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">$(TargetFrameworks);net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <PackageId>Verifiable.Query</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>verifiable-query</ToolCommandName>
    <Description>Pure .NET Core CLI query engine for asking formal yes/no verification questions with Z3 unsat-core explanations ("why") and counterexamples ("why not").</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Verifiable.Query.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verifiable.Contracts\Verifiable.Contracts.csproj" />
    <ProjectReference Include="..\Verifiable.Generators\Verifiable.Generators.csproj" />
    <ProjectReference Include="..\Verifiable.Analyzers\Verifiable.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\llms.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\schemas\*.schema.json" Pack="true" PackagePath="schemas" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="..\Verifiable.Generators\bin\$(Configuration)\netstandard2.0\Verifiable.Generators.dll" />
    <Analyzer Include="..\Verifiable.Analyzers\bin\$(Configuration)\netstandard2.0\Verifiable.Analyzers.dll" />
  </ItemGroup>

</Project>
