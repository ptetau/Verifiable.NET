<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="VerifiableZ3Path" />
    <CompilerVisibleProperty Include="VerifiableAllowMissingZ3" />
    <CompilerVisibleProperty Include="VerifiableAgent" />
    <CompilerVisibleProperty Include="VerifiableClosedEnums" />
    <CompilerVisibleProperty Include="VerifiableNonDefaultImmutableArrays" />
    <CompilerVisibleProperty Include="VerifiableMaxSpecClauses" />
  </ItemGroup>

  <!-- With VerifiableAllowMissingZ3, VER104 is a warning; keep it one under TreatWarningsAsErrors / -warnaserror. -->
  <Target Name="_VerifiableAllowMissingZ3" BeforeTargets="CoreCompile"
          Condition="'$(VerifiableAllowMissingZ3)' == 'true' or '$(VerifiableAllowMissingZ3)' == '1'">
    <PropertyGroup>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);VER104</WarningsNotAsErrors>
    </PropertyGroup>
  </Target>
</Project>
