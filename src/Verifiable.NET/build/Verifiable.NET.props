<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="VerifiableZ3Path" />
    <CompilerVisibleProperty Include="VerifiableAllowMissingZ3" />
    <CompilerVisibleProperty Include="VerifiableAllowWeakenedProofs" />
    <CompilerVisibleProperty Include="VerifiableAgent" />
    <CompilerVisibleProperty Include="VerifiableClosedEnums" />
    <CompilerVisibleProperty Include="VerifiableNonDefaultImmutableArrays" />
    <CompilerVisibleProperty Include="VerifiableMaxSpecClauses" />
    <CompilerVisibleProperty Include="VerifiableScope" />
    <CompilerVisibleProperty Include="VerifiableHolesAsWarnings" />
    <CompilerVisibleProperty Include="VerifiableZ3TimeoutMs" />
  </ItemGroup>

  <!-- R1: a spec clause manifest next to the project (*.clauses.json) turns on the clause drift gate
       (VER401-VER404). Set VerifiableClauseManifest to use a file somewhere else. -->
  <ItemGroup Condition="'$(VerifiableClauseManifest)' == ''">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/*.clauses.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(VerifiableClauseManifest)' != ''">
    <AdditionalFiles Include="$(VerifiableClauseManifest)" />
  </ItemGroup>

  <!-- With VerifiableAllowMissingZ3, VER104 is a warning; keep it one under TreatWarningsAsErrors / -warnaserror. -->
  <Target Name="_VerifiableAllowMissingZ3" BeforeTargets="CoreCompile"
          Condition="'$(VerifiableAllowMissingZ3)' == 'true' or '$(VerifiableAllowMissingZ3)' == '1'">
    <PropertyGroup>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);VER104</WarningsNotAsErrors>
    </PropertyGroup>
  </Target>

  <!-- With VerifiableAllowWeakenedProofs, VER107 is a warning; keep it one under TreatWarningsAsErrors / -warnaserror. -->
  <Target Name="_VerifiableAllowWeakenedProofs" BeforeTargets="CoreCompile"
          Condition="'$(VerifiableAllowWeakenedProofs)' == 'true' or '$(VerifiableAllowWeakenedProofs)' == '1'">
    <PropertyGroup>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);VER107</WarningsNotAsErrors>
    </PropertyGroup>
  </Target>
</Project>
